{
  "name": "@idop/mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "expo export --platform android --output-dir dist",
    "dev": "expo start",
    "dev:android": "expo start --android --localhost --clear",
    "dev:tunnel": "expo start --tunnel --go --clear",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ../../tsconfig.json"
  },
  "dependencies": {
    "expo": "~53.0.11",
    "expo-status-bar": "~2.2.3",
    "react": "19.0.0",
    "react-native": "0.79.3"
  },
  "devDependencies": {
    "@types/react": "^19.0.14"
  }
}
