{
  "name": "@idop/mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "expo export --platform android --output-dir dist",
    "dev": "expo start",
    "dev:android": "expo start --android --localhost --clear",
    "dev:tunnel": "expo start --tunnel --go --clear",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ../../tsconfig.json"
  },
  "dependencies": {
    "expo": "~54.0.35",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.17"
  }
}
